# Konfiguracja wdrożenia na serwer zdalny (npm run deploy).
#
# Skopiuj do .env.deploy i uzupełnij. Plik .env.deploy jest w .gitignore
# i nigdy nie trafia do repozytorium — zawiera dane dostępowe.
#
# Ścieżkę do katalogu strony znajdziesz po zalogowaniu przez SSH poleceniem
# `pwd` w katalogu domeny. Na MyDevil wygląda zwykle tak:
#   /usr/home/UZYTKOWNIK/domains/DOMENA/public_html

# Dane logowania SSH.
DEPLOY_SSH_HOST=serwer.example.net
DEPLOY_SSH_USER=twoj_login
DEPLOY_SSH_PORT=22

# Katalog, w którym leży WordPress na serwerze (bez ukośnika na końcu).
DEPLOY_REMOTE_WP=/usr/home/twoj_login/domains/example.com/public_html

# Adres strony docelowej, ze schematem, bez ukośnika na końcu.
# Używany przy podmianie adresów w bazie.
DEPLOY_REMOTE_URL=https://example.com

# Adres środowiska lokalnego — źródło podmiany. Zmieniaj tylko, jeśli
# uruchamiasz wp-env na innym porcie.
DEPLOY_LOCAL_URL=http://localhost:8888
